#!/usr/bin/env bash
# join-clips [--copy] OUT.mp4 CLIP CLIP [CLIP...]
# Stitch clips together in the given order. Re-encodes (libx264 crf 16 + AAC) so audio
# and video stay in sync; --copy skips re-encoding (fast, but audio can drift apart).
set -euo pipefail

codec=(-c:v libx264 -crf 16 -preset slow -pix_fmt yuv420p -c:a aac -b:a 192k)
if [ "${1:-}" = "--copy" ]; then codec=(-c copy); shift; fi
[ $# -ge 3 ] || { echo "usage: join-clips [--copy] OUT.mp4 CLIP CLIP [CLIP...]" >&2; exit 2; }
out="$1"; shift
[ -e "$out" ] && { echo "exists: $out" >&2; exit 1; }

list="$(mktemp)"; trap 'rm -f "$list"' EXIT
for c in "$@"; do
  [ -f "$c" ] || { echo "no such file: $c" >&2; exit 2; }
  abs="$(cd "$(dirname "$c")" && pwd)/$(basename "$c")"
  printf "file '%s'\n" "${abs//\'/\'\\\'\'}" >> "$list"
done

ffmpeg -v error -nostdin -stats -f concat -safe 0 -i "$list" "${codec[@]}" -movflags +faststart "$out"
echo "$out"
