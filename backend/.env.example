REDIS_URL=redis://localhost:6379/0
CORS_ALLOW_ORIGINS=http://localhost:8080
CORS_ALLOW_ORIGIN_REGEX=https?://[^/]+:8080

# Pen-plot rate limit: per-IP fixed window on POST /v1/images + /v1/convert.
# CPU-exposed endpoints; falls back to an in-process window when Redis is down.
PENPLOT_RATE_LIMIT=100
PENPLOT_RATE_LIMIT_WINDOW_S=60
# Comma-separated IPs exempt from the throttle (e.g. internal probes).
PENPLOT_RATE_LIMIT_WHITELIST=
