REDIS_URL=redis://localhost:6379/0
CORS_ALLOW_ORIGINS=http://localhost:8080
CORS_ALLOW_ORIGIN_REGEX=https?://[^/]+:8080

# Pen-plot rate limit: per-IP fixed window shared across all /v1 endpoints
# (POST /v1/images, POST /v1/convert, GET /v1/images/{id}, GET /v1/results/{f}).
# CPU-exposed endpoints; falls back to an in-process window when Redis is down.
PENPLOT_RATE_LIMIT=100
PENPLOT_RATE_LIMIT_WINDOW_S=60
# Comma-separated IPs exempt from the throttle (e.g. internal probes).
PENPLOT_RATE_LIMIT_WHITELIST=
# Trust X-Forwarded-For as the client IP (1). v1 must run behind a proxy/CDN
# that OVERWRITES that header; set 0 on a directly-exposed instance.
PENPLOT_TRUST_FORWARDED_FOR=1
# Max upload size in bytes (default 25 MB). Larger files are rejected
# with 413 payload_too_large before format sniffing.
# PENPLOT_MAX_UPLOAD_BYTES=26214400

# City maps (OpenStreetMap via Nominatim + Overpass, Redis-cached 24h).
# CITYMAP_CACHE_TTL_HOURS=24
# CITYMAP_MAX_BBOX_DEG=0.8
# CITYMAP_OVERPASS_TIMEOUT_S=30
# Overpass mirrors + per-mirror retry (5xx/network only; 400/403 fail fast).
# CITYMAP_OVERPASS_URLS=["https://overpass-api.de/api/interpreter", "https://overpass.kumi.systems/api/interpreter", "https://overpass.private.coffee/api/interpreter", "https://overpass.openstreetmap.fr/api/interpreter", "https://overpass.nchc.org.tw/api/interpreter"]
# CITYMAP_OVERPASS_RETRIES=1
# CITYMAP_OVERPASS_RETRY_BACKOFF_S=1.0
# OSM /map fallback: small cells + adaptive 400-subdivide + per-cell retry.
# CITYMAP_OSM_API_MAX_DEG=0.1
# CITYMAP_OSM_API_MIN_DEG=0.025
# CITYMAP_OSM_API_RETRIES=2
# CITYMAP_OSM_API_RETRY_BACKOFF_S=0.5
