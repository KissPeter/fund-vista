<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Disk-space guard for the Mac (issue #111).

  Install once (KeepLocal so a deploy does not clobber a file launchd runs):

    cp ops/mac-disk-guard.sh ~/bin/mac-disk-guard.sh
    mkdir -p ~/Library/LaunchAgents
    sed "s|HOME_DIR|$HOME|g" ops/mac-disk-guard.plist \
      > ~/Library/LaunchAgents/hu.linuxadm.disk-guard.plist
    launchctl bootstrap gui/$(id -u) \
      ~/Library/LaunchAgents/hu.linuxadm.disk-guard.plist
-->
<dict>
  <key>Label</key>
  <string>hu.linuxadm.disk-guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>HOME_DIR/bin/mac-disk-guard.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PRUNE</key>
    <string>1</string>
    <key>RECOVER</key>
    <string>1</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- All 24 hours: the 2026-11-21 breach started after the old 22:00 run. -->
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>HOME_DIR/Library/Logs/disk-guard.log</string>
  <key>StandardErrorPath</key>
  <string>HOME_DIR/Library/Logs/disk-guard.log</string>
</dict>
</plist>
