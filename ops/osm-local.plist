<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Local OSM extract service (CR-010): Overpass-compatible API on :8200.

  Install once, after building the database (docs/CR-010-local-osm-extract.md):

    mkdir -p ~/Library/LaunchAgents
    sed -e "s|HOME_DIR|$HOME|g" -e "s|REPO_DIR|$PWD|g" ops/osm-local.plist \
      > ~/Library/LaunchAgents/hu.linuxadm.osm-local.plist
    launchctl bootstrap gui/$(id -u) \
      ~/Library/LaunchAgents/hu.linuxadm.osm-local.plist
-->
<dict>
  <key>Label</key>
  <string>hu.linuxadm.osm-local</string>
  <key>WorkingDirectory</key>
  <string>REPO_DIR</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>REPO_DIR</string>
    <key>OSM_LOCAL_DB</key>
    <string>HOME_DIR/srv/osm-local/osm-hu.sqlite</string>
    <key>OSM_LOCAL_HOST</key>
    <string>127.0.0.1</string>
    <key>OSM_LOCAL_PORT</key>
    <string>8200</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>uv</string>
    <string>run</string>
    <string>--project</string>
    <string>backend</string>
    <string>python</string>
    <string>-m</string>
    <string>backend.osm_local.server</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>HOME_DIR/Library/Logs/osm-local.log</string>
  <key>StandardErrorPath</key>
  <string>HOME_DIR/Library/Logs/osm-local.log</string>
</dict>
</plist>
